    (title "TAPH carrier rev 0 - Architecture")
    (date "2026-11-07")
    (rev "0-prelim")
    (company "TAPH research - PRELIMINARY - NOT FOR FABRICATION")
    (comment 1 "Design-review prototype. Not reviewed for manufacture, assembly or energization.")
    (comment 2 "Unverified external components: sensor, generator, pump, servo, supply. See pcb/rev0/docs.")
